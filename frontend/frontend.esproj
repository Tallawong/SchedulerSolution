<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.1635611">
  <PropertyGroup>
    <!-- The command executed when you click 'Start' or press F5 in Visual Studio -->
    <StartupCommand>npm run start:dev</StartupCommand>
    <!-- JavaScript testing framework configured for the project -->
    <JavaScriptTestFramework>Jasmine</JavaScriptTestFramework>
    <!-- Ensures standard VS builds don't run production compilation sequentially during active debugging -->
    <ShouldRunBuildScript>false</ShouldRunBuildScript>
    <!-- Specifies where Angular places production-compiled assets (Matches angular.json output) -->
    <BuildOutputFolder>$(MSBuildProjectDirectory)\dist\frontend\browser\</BuildOutputFolder>
  </PropertyGroup>
  <ItemGroup>
    <None Include=".vscode\tasks.json" />
  </ItemGroup>
</Project>
